# =============================================================================
# fstab (twrp.fstab) — LG X120 / mmh6lm / MT6739
# Fonte: extraído de /vendor/etc/fstab.mmh6lm via ADB no aparelho
# (filesystems reais, não chutes)
# =============================================================================

# --- Montagens de recovery (leitura e escrita) ---
/dev/block/by-name/system      /system      ext4  rw  backupnorw
/dev/block/by-name/vendor      /vendor      ext4  rw  backupnorw
/dev/block/by-name/product     /product     ext4  rw  backupnorw
/dev/block/by-name/cache       /cache       ext4  rw  backupnorw
/dev/block/by-name/userdata    /data        f2fs  rw  backupnorw
/dev/block/by-name/carrier     /carrier     ext4  rw  backupnorw
/dev/block/by-name/lk          /lk          emmc  rw  backupnosearch
/dev/block/by-name/lk2         /lk2         emmc  rw  backupnosearch
/dev/block/by-name/boot        /boot        emmc  rw  backupnosearch
/dev/block/by-name/recovery    /recovery    emmc  rw  backupnosearch
/dev/block/by-name/recoverybak /recoverybak emmc  rw  backupnosearch
/dev/block/by-name/vbmeta      /vbmeta      emmc  rw  backupnosearch
/dev/block/by-name/dtbo        /dtbo        emmc  rw  backupnosearch
/dev/block/by-name/para        /para        emmc  rw  backupnosearch
/dev/block/by-name/misc2       /misc2       emmc  rw  backupnosearch
/dev/block/by-name/seccfg      /seccfg      emmc  rw  backupnosearch
/dev/block/by-name/md1img      /md1img      emmc  rw  backupnosearch
/dev/block/by-name/logo        /logo        emmc  rw  backupnosearch
/dev/block/by-name/expdb       /expdb       emmc  rw  backupnosearch
/dev/block/by-name/proinfo     /proinfo     emmc  rw  backupnosearch
/dev/block/by-name/nvram       /nvram       emmc  rw  backupnosearch
/dev/block/by-name/nvdata      /nvdata      ext4  rw  backupnosearch
/dev/block/by-name/nvcfg       /nvcfg       ext4  rw  backupnosearch
/dev/block/by-name/protect1    /protect1    ext4  rw  backupnosearch
/dev/block/by-name/protect2    /protect2    ext4  rw  backupnosearch
/dev/block/by-name/persist     /persist     ext4  rw  backupnosearch
/dev/block/by-name/persist_lg  /persist_lg  ext4  rw  backupnosearch
/dev/block/by-name/power       /power       ext4  rw  backupnosearch
/dev/block/by-name/mpt         /mpt         ext4  rw  backupnosearch
/dev/block/by-name/frp         /frp         emmc  rw  backupnosearch

# --- Externo (SD, OTG, flash) ---
/devices/platform/externdevice*     auto  auto  defaults  voldmanaged=sdcard1:auto
/devices/platform/11200000.usb0/musb-hdrc/usb*  auto  auto  defaults  voldmanaged=usbotg:auto
